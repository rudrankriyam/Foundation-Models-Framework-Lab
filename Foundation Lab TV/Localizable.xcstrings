    "Explain how a rainbow forms in three sentences." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkläre in drei Sätzen, wie ein Regenbogen entsteht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explain how a rainbow forms in three sentences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica en tres frases cómo se forma un arcoíris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explique en trois phrases comment se forme un arc-en-ciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiega in tre frasi come si forma un arcobaleno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虹ができる仕組みを3文で説明してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무지개가 생기는 원리를 세 문장으로 설명해 줘."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explique em três frases como um arco-íris se forma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用三句话解释彩虹是如何形成的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用三句話解釋彩虹是如何形成的。"
          }
        }
      }
    },
